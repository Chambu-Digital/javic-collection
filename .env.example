# Database
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/freight_db

# JWT Secret
JWT_SECRET=your_jwt_secret_here

# Google OAuth (for customer login)
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Google Ads API (for campaign management)
GOOGLE_ADS_CLIENT_ID=your_google_ads_client_id
GOOGLE_ADS_CLIENT_SECRET=your_google_ads_client_secret
GOOGLE_ADS_DEVELOPER_TOKEN=your_developer_token
GOOGLE_ADS_CUSTOMER_ID=your_customer_id
GOOGLE_ADS_LOGIN_CUSTOMER_ID=your_login_customer_id

# M-Pesa Configuration (for payments)
MPESA_BUSINESS_SHORT_CODE=your_shortcode
MPESA_CONSUMER_KEY=your_consumer_key
MPESA_CONSUMER_SECRET=your_consumer_secret
MPESA_PASSKEY=your_passkey
MPESA_CALLBACK_URL=https://yoursite.com/api/payments/mpesa/callback
MPESA_TIMEOUT_URL=https://yoursite.com/api/payments/mpesa/timeout

# Company Information
COMPANY_NAME=Jiji East Africa Limited
COMPANY_PHONE=+254 (0)20 XXXX XXXX
COMPANY_EMAIL=support@jijifreight.com
COMPANY_WEBSITE=https://www.jijifreight.com
COMPANY_ADDRESS=Nairobi, Kenya

# Branding
BRAND_PRIMARY_COLOR=#003D7A
BRAND_SECONDARY_COLOR=#1E90FF
BRAND_ACCENT_COLOR=#FFD700

# Email Configuration
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_app_password
SMTP_FROM=noreply@javic-freight.com

# SMS Configuration (for notifications)
SMS_PROVIDER=Africa\'s Talking # or Twilio
AFRICAS_TALKING_API_KEY=your_api_key
AFRICAS_TALKING_USERNAME=your_username
TWILIO_ACCOUNT_SID=your_account_sid
TWILIO_AUTH_TOKEN=your_auth_token
TWILIO_PHONE_NUMBER=+254712345678

# S3 / Cloud Storage (for document uploads)
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=javic-freight-uploads
AWS_REGION=us-east-1

# Maps API (for distance calculation & tracking)
GOOGLE_MAPS_API_KEY=your_maps_api_key

# Feature Flags
ENABLE_TRACKING=true
ENABLE_MERCHANDISE=true
ENABLE_GOOGLE_ADS=true
ENABLE_OFFLINE_MODE=true

# Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW=900000 # 15 minutes

# Node Environment
NODE_ENV=development # development, staging, production

# API Base URLs
NEXT_PUBLIC_API_URL=http://localhost:3000
NEXT_PUBLIC_TRACKING_URL=https://track.javic-freight.com

# Logging
LOG_LEVEL=debug # debug, info, warn, error
LOG_TO_FILE=true
LOG_FILE_PATH=/var/log/freight-app.log

# Stripe Integration (alternative to M-Pesa)
STRIPE_PUBLIC_KEY=pk_test_xxxxx
STRIPE_SECRET_KEY=sk_test_xxxxx

# Job Queue (for background tasks)
REDIS_URL=redis://localhost:6379

# Analytics
GOOGLE_ANALYTICS_ID=UA-XXXXXXXXX-X
MIXPANEL_TOKEN=your_mixpanel_token

# Sentry (error tracking)
SENTRY_DSN=https://xxxxx@sentry.io/xxxxx
